// ==UserScript==
// @name         Diep Khuc - Persistent User Labels
// @namespace    diep-khuk-user-labels
// @version      2.2.0
// @description  Persistent custom labels using userInfo.openId
// @match        https://diepkhuc.com/*
// @match        https://www.diepkhuc.com/*
// @run-at       document-idle
// @grant        none
// ==/UserScript==

(function () {
    "use strict";
    // =========================================================
    // SUPABASE CONNECTION
    // =========================================================

    const SUPABASE_URL = "https://bawpoebuldxlvbrwmvrw.supabase.co";
    const SUPABASE_KEY = "sb_publishable_lIhggWrSkFhe3BLeJmDpvw_oLfmd2bV";

    let supabase = null;
    let currentWorkspaceId = null;
    let currentWorkspaceOwnerOpenId = null;
    let currentUserOpenId = null;
    const pendingRecords = {};
    const activeUsers = {};
    const updateTimers = {};

    function loadSupabase() {
        return new Promise((resolve, reject) => {
            if (window.supabase) {
                supabase = window.supabase.createClient(
                    SUPABASE_URL,
                    SUPABASE_KEY
                );

                console.log("[DK] Supabase connected");
                resolve(supabase);
                return;
            }

            const script = document.createElement("script");

            script.src =
                "https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2";

            script.onload = () => {
                try {
                    supabase = window.supabase.createClient(
                        SUPABASE_URL,
                        SUPABASE_KEY
                    );

                    console.log("[DK] Supabase connected");
                    resolve(supabase);
                } catch (err) {
                    console.error(
                        "[DK] Supabase connection failed:",
                        err
                    );
                    reject(err);
                }
            };

            script.onerror = () => {
                console.error("[DK] Failed to load Supabase");
                reject(new Error("Failed to load Supabase"));
            };

            document.head.appendChild(script);
        });
    }

    loadSupabase().then(() => {
        const script = document.createElement("script");

        script.textContent = `
        (function waitForDKUser() {
            try {
                const u = getMyUserInfo();

                if (u && u.openId) {
                    document.documentElement.setAttribute(
                        "data-dk-current-user",
                        JSON.stringify(u)
                    );

                    document.documentElement.setAttribute(
                        "data-dk-current-user-ready",
                        "1"
                    );

                    return;
                }
            } catch (e) {}

            setTimeout(waitForDKUser, 500);
        })();
    `;

        document.documentElement.appendChild(script);
        script.remove();

        const waitForUser = setInterval(() => {
            const raw =
                  document.documentElement.getAttribute(
                      "data-dk-current-user"
                  );

            if (!raw) {
                return;
            }

            clearInterval(waitForUser);

            const userInfo = JSON.parse(raw);

            console.log("[DK] Current user:", userInfo);

            checkUserWorkspace(userInfo);
        }, 100);
    });
    // =========================================================
    // WORKSPACE CHECK
    // =========================================================

    async function checkUserWorkspace(userInfo) {
        if (!supabase || !userInfo) {
            return;
        }

        const openId = getOpenId(userInfo);
        currentUserOpenId = openId;


        if (!openId) {
            console.error("[DK] Cannot get current user openId");
            return;
        }


        // 1. Anonymous auth
        const { data: authData, error: authError } =
              await supabase.auth.signInAnonymously();

        if (authError) {
            console.error("[DK] Anonymous auth failed:", authError);
            return;
        }

        console.log(
            "[DK] Auth OK:",
            authData.user?.id
        );

        // 2. Register current user
        const { error: registerError } =
              await supabase.rpc(
                  "register_current_user",
                  {
                      p_open_id: openId,
                      p_nick: userInfo.nick || ""
                  }
              );

        if (registerError) {
            console.error(
                "[DK] Register current user failed:",
                registerError
            );
            return;
        }

        console.log(
            "[DK] Current user registered:",
            openId
        );

        // 3. Check workspaces
        const { data: workspaces, error: workspaceError } =
              await supabase.rpc("get_my_workspaces");
        await loadWorkspaceOptions();

        if (workspaceError) {
            console.error(
                "[DK] Check workspace failed:",
                workspaceError
            );
            return;
        }

        console.log(
            "[DK] My workspaces:",
            workspaces
        );

        // 4. Already has workspace → do nothing
        if (workspaces && workspaces.length > 0) {

            const ownWorkspace =
                  workspaces.find(
                      workspace =>
                      workspace.owner_open_id ===
                      currentUserOpenId
                  );

            const defaultWorkspace =
                  ownWorkspace ||
                  workspaces[0];

            currentWorkspaceId =
                defaultWorkspace.id;

            currentWorkspaceOwnerOpenId =
                defaultWorkspace.owner_open_id;

            console.log(
                "[DK] Using default workspace:",
                defaultWorkspace
            );

            applyAll();
            return;
        }

        // 5. No workspace → wait for user to create/join one
        currentWorkspaceId = null;
        currentWorkspaceOwnerOpenId = null;
    }

    const STORAGE_KEY = "__dk_user_labels_openid_v2__";

    let records = loadRecords();

    // =========================================================
    // STORAGE
    // =========================================================

    function loadRecords() {
        try {
            const raw = localStorage.getItem(STORAGE_KEY);

            if (!raw) {
                return {};
            }

            const data = JSON.parse(raw);

            if (!data || typeof data !== "object") {
                return {};
            }

            return data;
        } catch (err) {
            console.error(
                "[DK Label] Failed to load records:",
                err
            );

            return {};
        }
    }

    function saveRecords() {
        try {
            localStorage.setItem(
                STORAGE_KEY,
                JSON.stringify(records)
            );
        } catch (err) {
            console.error(
                "[DK Label] Failed to save records:",
                err
            );
        }
    }

    // =========================================================
    // SYNC GIỮA CÁC TAB
    // =========================================================

    window.addEventListener("storage", function (e) {
        if (e.key !== STORAGE_KEY) {
            return;
        }

        records = loadRecords();

        console.log(
            "[DK Label] Synced from another tab"
        );

        applyAll();
    });

    // =========================================================
    // REACT FIBER
    // =========================================================

    function getFiberKey(el) {
        if (!el) {
            return null;
        }

        return Object.keys(el).find(
            key => key.startsWith("__reactFiber$")
        ) || null;
    }

    function getUserInfoFromElement(el) {
        if (!el) {
            return null;
        }

        const fiberKey = getFiberKey(el);

        if (!fiberKey) {
            return null;
        }

        let fiber = el[fiberKey];

        for (let i = 0; i < 50 && fiber; i++) {
            const props = fiber.memoizedProps;

            if (props?.userInfo?.userId) {
                return props.userInfo;
            }

            fiber = fiber.return;
        }

        return null;
    }

    // =========================================================
    // IDENTITY
    // =========================================================

    function getOpenId(userInfo) {
        if (!userInfo) {
            return null;
        }

        const value = userInfo.openId;

        if (
            value === undefined ||
            value === null ||
            value === ""
        ) {
            return null;
        }

        return String(value);
    }

    // =========================================================
    // RECORD
    // =========================================================
    //
    // openId CHƯA CÓ:
    //     tạo record
    //     label = nickname hiện tại
    //
    // openId ĐÃ CÓ:
    //     giữ nguyên record
    //     KHÔNG overwrite label
    //     KHÔNG overwrite nick
    //
    // =========================================================

    async function ensureRecord(userInfo) {
        // Capture workspace tại thời điểm request bắt đầu
        const workspaceId = currentWorkspaceId;
        const workspaceOwnerOpenId = currentWorkspaceOwnerOpenId;

        const openId = getOpenId(userInfo);

        if (!openId || !workspaceId || !supabase) {
            return null;
        }

        const localKey =
              `${workspaceId}:${openId}`;

        const isOwnWorkspace =
              workspaceOwnerOpenId === currentUserOpenId;

        const requestKey =
              `${workspaceId}:${openId}`;

        // Đang check user này → dùng chung Promise
        if (pendingRecords[requestKey]) {
            return await pendingRecords[requestKey];
        }

        pendingRecords[requestKey] = (async () => {

            // 1. Check Supabase
            const { data, error } = await supabase
            .from("user_labels")
            .select("label")
            .eq("workspace_id", workspaceId)
            .eq("target_open_id", openId)
            .maybeSingle();

            console.log(
                "[DK Label] DB RESULT:",
                {
                    workspaceId,
                    openId,
                    data
                }
            );

            if (error) {
                console.error(
                    `[DK Label] Failed to check ${openId}:`,
                    error
                );

                return null;
            }

            // 2. Supabase đã có label
            if (data) {
                const record = {
                    nick: userInfo.nick || "",
                    label: data.label || "",
                    updated: true
                };

                const oldRecord = records[localKey];

                if (!oldRecord || oldRecord.label !== record.label) {
                    records[localKey] = record;
                    saveRecords();

                    console.log(
                        `[DK Label] DB changed: ${openId} → ${record.label}`
                    );
                }

                return record;
            }

            // 3. Supabase chưa có
            // Có local → dùng local
            // Không có local → dùng nickname
            const oldRecord = records[localKey];
            const currentNick = userInfo.nick || "";

            const record = oldRecord || {
                nick: currentNick,
                label: currentNick,
                updated: false
            };

            records[localKey] = record;
            saveRecords();

            // Workspace của người khác → chỉ đọc, không tạo label
            if (!isOwnWorkspace) {
                return record;
            }

            // Workspace của mình → tạo record trên Supabase
            const { error: insertError } = await supabase
            .from("user_labels")
            .insert({
                workspace_id: workspaceId,
                target_open_id: openId,
                label: record.label,
                created_by: currentUserOpenId,
                updated_by: currentUserOpenId
            });

            if (insertError) {
                console.error(
                    `[DK Label] Failed to create ${openId}:`,
                    insertError
                );

                return record;
            }

            console.log(
                `[DK Label] New user synced: ${openId} → ${record.label}`
            );

            return record;

        })();

        try {
            return await pendingRecords[requestKey];
        } finally {
            delete pendingRecords[requestKey];
        }
    }

    // =========================================================
    // CREATE UI
    // =========================================================
    function updateSameOpenIdUI(workspaceId, openId, label, sourceInput) {
        const items = document.querySelectorAll(".user-list .item");

        for (const item of items) {
            const userInfo = getUserInfoFromElement(item);
            if (!userInfo) continue;

            if (getOpenId(userInfo) !== openId) continue;

            const input = item.querySelector(".dk-user-label-input");
            if (!input || input === sourceInput) continue;

            // Nếu nick kia cũng đang được gõ thì không đè input của nó
            if (document.activeElement === input) continue;

            input.value = label;
        }
    }
    function createUI(item, userInfo, record) {
        if (!item || !userInfo || !record) {
            return;
        }

        const nickEl = item.querySelector(".nick");

        if (!nickEl) {
            return;
        }

        // UI đã tồn tại
        if (
            nickEl.parentElement?.querySelector(
                ".dk-user-label-wrap"
            )
        ) {
            return;
        }

        const openId = getOpenId(userInfo);
        console.log(
            "[DK Label] Processing:",
            openId,
            userInfo.nick
        );

        if (!openId) {
            return;
        }

        // -----------------------------------------------------
        // Wrapper
        // -----------------------------------------------------

        const wrap = document.createElement("span");

        wrap.className = "dk-user-label-wrap";

        wrap.style.cssText = `
            display: inline-flex;
            align-items: center;
            margin-left: 6px;
            vertical-align: middle;
        `;

        // -----------------------------------------------------
        // Input
        // -----------------------------------------------------

        const input = document.createElement("input");

        input.className = "dk-user-label-input";
        input.type = "text";

        input.value = record.label || "";
        if (
            currentWorkspaceOwnerOpenId &&
            currentWorkspaceOwnerOpenId !== currentUserOpenId
        ) {
            input.disabled = true;
        }

        input.style.cssText = `
            width: 130px;
            height: 24px;
            padding: 0px 3px;
            box-sizing: border-box;
            border: 1px solid #aaa;
            border-radius: 3px;
            font-size: 18px;
            line-height: 20px;
            color: #222;
            background: #fff;
            outline: none;
        `;

        // -----------------------------------------------------
        // Khi gõ → lưu NGAY
        // -----------------------------------------------------

        input.addEventListener("input", function () {

            // Chụp workspace ngay tại thời điểm người dùng gõ
            const workspaceIdAtInput = currentWorkspaceId;

            const localKey =
                  `${workspaceIdAtInput}:${openId}`;

            const currentRecord =
                  records[localKey];

            if (!currentRecord) {
                return;
            }

            // Local cập nhật ngay từng ký tự
            currentRecord.label = input.value;
            currentRecord.updated = true;

            saveRecords();
            updateSameOpenIdUI(
                workspaceIdAtInput,
                openId,
                currentRecord.label,
                input
            );

            console.log(
                `[DK Label] Saved local: ${openId} → ${currentRecord.label}`
            );

            // -----------------------------------------------------
            // Supabase: debounce 500ms
            // -----------------------------------------------------
            clearTimeout(currentRecord.updateTimer);

            currentRecord.updateTimer = setTimeout(async function () {

                if (
                    !supabase ||
                    !workspaceIdAtInput ||
                    !currentUserOpenId
                ) {
                    return;
                }

                const labelToSave =
                      currentRecord.label;

                const { error } = await supabase
                .from("user_labels")
                .update({
                    label: labelToSave,
                    updated_by: currentUserOpenId,
                    updated_at: new Date().toISOString()
                })
                .eq("workspace_id", workspaceIdAtInput)
                .eq("target_open_id", openId);

                if (error) {
                    console.error(
                        `[DK Label] Failed to update ${openId}:`,
                        error
                    );
                } else {
                    console.log(
                        `[DK Label] Updated Supabase: ${openId} → ${labelToSave}`
                    );
                }

            }, 500);
        });

        // -----------------------------------------------------
        // Không cho click input trigger item
        // -----------------------------------------------------

        input.addEventListener("click", function (e) {
            e.stopPropagation();
        });

        input.addEventListener("mousedown", function (e) {
            e.stopPropagation();
        });

        input.addEventListener("mouseup", function (e) {
            e.stopPropagation();
        });

        input.addEventListener("keydown", function (e) {
            e.stopPropagation();
        });

        // -----------------------------------------------------
        // Append
        // -----------------------------------------------------

        wrap.appendChild(input);

        nickEl.append(wrap);
    }

    // =========================================================
    // UPDATE EXISTING UI
    // =========================================================
    //
    // Cực kỳ quan trọng:
    //
    // Nếu input đang focus → KHÔNG BAO GIỜ overwrite value.
    //
    // Nhờ vậy:
    //
    // gõ A
    // gõ AB
    // gõ ABC
    //
    // React re-render giữa chừng cũng không làm mất chữ.
    //
    // =========================================================

    function updateExistingUI(item, record) {
        if (!item || !record) {
            return;
        }

        const wrap =
              item.querySelector(
                  ".dk-user-label-wrap"
              );

        if (!wrap) {
            return;
        }

        const input =
              wrap.querySelector(
                  ".dk-user-label-input"
              );

        if (!input) {
            return;
        }

        input.disabled =
            currentWorkspaceOwnerOpenId &&
            currentWorkspaceOwnerOpenId !== currentUserOpenId;

        // Đang gõ
        if (document.activeElement === input) {
            return;
        }

        // Không focus → sync từ storage
        const savedLabel = record.label || "";

        if (input.value !== savedLabel) {
            input.value = savedLabel;
        }
    }

    // =========================================================
    // PROCESS ITEM
    // =========================================================

    async function processItem(item) {
        if (!item) {
            return;
        }

        if (!item.classList.contains("item")) {
            return;
        }

        const userInfo =
              getUserInfoFromElement(item);

        if (!userInfo) {
            return;
        }

        const openId =
              getOpenId(userInfo);

        if (!openId) return;

        const workspaceIdAtProcess = currentWorkspaceId;

        const userKey =
              `${workspaceIdAtProcess}:${openId}`;



        // =====================================================
        // 1. LOCAL FIRST
        // =====================================================

        const localKey = `${workspaceIdAtProcess}:${openId}`;
        let record = records[localKey];

        // Chưa có local → dùng nickname làm label tạm
        if (!record) {
            const currentNick = userInfo.nick || "";

            record = {
                nick: currentNick,
                label: currentNick,
                updated: false
            };

            records[localKey] = record;
            saveRecords();
        }

        // Gắn label từ LOCAL ngay lập tức
        createUI(
            item,
            userInfo,
            record
        );

        updateExistingUI(
            item,
            record
        );

        // =====================================================
        // 2. USER ĐANG ACTIVE → KHÔNG SYNC LẠI
        // =====================================================

        if (activeUsers[userKey]) {
            return;
        }

        activeUsers[userKey] = true;

        // =====================================================
        // 3. SUPABASE SYNC BACKGROUND
        // =====================================================
        ensureRecord(userInfo)
            .then((syncedRecord) => {
            if (!syncedRecord) return;

            if (currentWorkspaceId !== workspaceIdAtProcess) {
                return;
            }

            updateExistingUI(item, syncedRecord);
        })

            .catch((err) => {
            console.error(
                `[DK Label] Background sync failed: ${openId}`,
                err
            );
        });
    }

    // =========================================================
    // APPLY ALL
    // =========================================================

    async function applyAll() {
        const items =
              document.querySelectorAll(
                  ".user-list .item"
              );

        let applied = 0;

        const currentUsers = {};

        for (const item of items) {
            const userInfo =
                  getUserInfoFromElement(item);

            if (!userInfo) {
                continue;
            }

            const openId =
                  getOpenId(userInfo);

            if (!openId) {
                continue;
            }

            const userKey =
                  `${currentWorkspaceId}:${openId}`;

            currentUsers[userKey] = true;

            const existed =
                  !!item.querySelector(
                      ".dk-user-label-wrap"
                  );

            await processItem(item);

            const existsNow =
                  !!item.querySelector(
                      ".dk-user-label-wrap"
                  );

            if (!existed && existsNow) {
                applied++;
            }
        }

        // User không còn trong room → reset trạng thái
        for (const key of Object.keys(activeUsers)) {
            if (!currentUsers[key]) {
                delete activeUsers[key];
            }
        }

        if (applied > 0) {
            console.log(
                `[DK Label] Applied: ${applied} items`
            );
        }
    }

    // =========================================================
    // OBSERVER
    // =========================================================

    function installObserver() {
        const userList =
              document.querySelector(
                  ".user-list"
              );

        if (!userList) {
            setTimeout(
                installObserver,
                1000
            );

            return;
        }

        const observer =
              new MutationObserver(() => {
                  applyAll();
              });

        observer.observe(
            userList,
            {
                childList: true,
                subtree: true
            }
        );

        console.log(
            "[DK Label] Observer installed"
        );
    }

    // =========================================================
    // WORKSPACE COMBOBOX UI
    // =========================================================
    function clearLabelUI() {
        document
            .querySelectorAll(".dk-user-label-wrap")
            .forEach(el => el.remove());
    }
    function createWorkspaceCombobox() {
        if (document.querySelector("#dk-workspace-panel")) {
            return;
        }

        const target =
              document.querySelector(
                  'div[data-class="DynamicButton"]'
              )?.parentElement;

        if (!target) {
            setTimeout(createWorkspaceCombobox, 1000);
            return;
        }

        const panel = document.createElement("div");

        panel.id = "dk-workspace-panel";

        panel.style.cssText = `
        width: 180px;
        margin-bottom: 5px;
        box-sizing: border-box;
        font-size: 14px;
    `;

        // =========================================================
        // COMBOBOX
        // =========================================================

        const select = document.createElement("select");

        select.id = "dk-workspace-combobox";

        select.style.cssText = `
        width: 180px;
        height: 32px;
        padding: 2px 6px;
        box-sizing: border-box;
        border: 1px solid #aaa;
        border-radius: 4px;
        background: #fff;
        color: #222;
        font-size: 14px;
        outline: none;
    `;

        const defaultOption = document.createElement("option");

        defaultOption.value = "";
        defaultOption.textContent = "Workspace";

        select.appendChild(defaultOption);

        panel.appendChild(select);

        // =========================================================
        // ACTION AREA
        // =========================================================

        const actionArea = document.createElement("div");

        actionArea.style.cssText = `
        margin-top: 5px;
        display: flex;
        flex-direction: column;
        gap: 5px;
    `;

        // =========================================================
        // JOIN WORKSPACE
        // =========================================================

        const joinTitle = document.createElement("div");

        joinTitle.textContent = "🔗 Join workspace";

        joinTitle.style.cssText = `
        font-weight: bold;
        cursor: pointer;
        user-select: none;
    `;

        const joinArea = document.createElement("div");

        joinArea.style.cssText = `
        display: none;
        flex-direction: column;
        gap: 4px;
    `;

        const joinNameInput = document.createElement("input");

        joinNameInput.type = "text";
        joinNameInput.placeholder = "Workspace name";

        joinNameInput.style.cssText = `
        width: 180px;
        height: 28px;
        padding: 2px 6px;
        box-sizing: border-box;
        border: 1px solid #aaa;
        border-radius: 4px;
        font-size: 13px;
        outline: none;
    `;

        const joinSecretInput = document.createElement("input");

        joinSecretInput.type = "password";
        joinSecretInput.placeholder = "Secret";

        joinSecretInput.style.cssText = `
        width: 180px;
        height: 28px;
        padding: 2px 6px;
        box-sizing: border-box;
        border: 1px solid #aaa;
        border-radius: 4px;
        font-size: 13px;
        outline: none;
    `;

        const joinButton = document.createElement("button");

        joinButton.type = "button";
        joinButton.textContent = "Join";

        joinButton.style.cssText = `
        width: 180px;
        height: 28px;
        cursor: pointer;
        border: 1px solid #aaa;
        border-radius: 4px;
        background: #f5f5f5;
        color: #222;
        font-size: 13px;
    `;

        joinArea.appendChild(joinNameInput);
        joinArea.appendChild(joinSecretInput);
        joinArea.appendChild(joinButton);

        joinTitle.addEventListener("click", function () {
            joinArea.style.display =
                joinArea.style.display === "none"
                ? "flex"
            : "none";
        });

        joinButton.addEventListener("click", async function (e) {
            e.stopPropagation();

            if (!supabase || !currentUserOpenId) {
                return;
            }

            const workspaceName = joinNameInput.value.trim();
            const workspaceSecret = joinSecretInput.value.trim();

            if (!workspaceName || !workspaceSecret) {
                alert("Please enter workspace name and secret.");
                return;
            }

            joinButton.disabled = true;

            try {

                // 1. Join workspace qua RPC
                const { data: workspace, error: workspaceError } =
                      await supabase.rpc(
                          "join_workspace",
                          {
                              p_workspace_name: workspaceName,
                              p_secret: workspaceSecret
                          }
                      );

                if (workspaceError) {
                    console.error(
                        "[DK Workspace] Join workspace failed:",
                        workspaceError
                    );

                    alert(
                        "Join workspace failed: " +
                        workspaceError.message
                    );

                    return;
                }

                if (!workspace) {
                    alert("Workspace not found.");
                    return;
                }
                // 5. Chuyển sang workspace vừa join
                Object.keys(activeUsers).forEach(key => delete activeUsers[key]);

                clearLabelUI();

                currentWorkspaceId = workspace.id;
                currentWorkspaceOwnerOpenId = workspace.owner_open_id;

                // 6. Xóa input
                joinNameInput.value = "";
                joinSecretInput.value = "";

                // 7. Reload combobox
                await loadWorkspaceOptions();

                const select =
                      document.querySelector(
                          "#dk-workspace-combobox"
                      );

                if (select) {
                    select.value =
                        String(currentWorkspaceId);
                }

                console.log(
                    "[DK Workspace] Joined workspace:",
                    workspace
                );

                // 8. Apply label
                applyAll();

            } finally {
                joinButton.disabled = false;
            }
        });

        // =========================================================
        // CREATE OWN WORKSPACE
        // =========================================================

        const createTitle = document.createElement("div");

        createTitle.textContent =
            "➕ Create own workspace";

        createTitle.style.cssText = `
        font-weight: bold;
        cursor: pointer;
        user-select: none;
    `;

        createTitle.addEventListener("click", async function () {
            if (!supabase || !currentUserOpenId) {
                return;
            }



            createTitle.style.pointerEvents = "none";

            try {
                // Kiểm tra workspace của chính user
                const { data: workspaces, error: wsError } =
                      await supabase.rpc("get_my_workspaces");

                if (wsError) {
                    console.error(
                        "[DK Workspace] Failed to load workspaces:",
                        wsError
                    );
                    return;
                }

                const ownWorkspace = (workspaces || []).find(
                    workspace =>
                    workspace.owner_open_id === currentUserOpenId
                );

                // =========================================
                // ĐÃ CÓ WORKSPACE → GET SECRET
                // =========================================
                if (ownWorkspace) {

                    const { data: secret, error: secretError } =
                          await supabase.rpc(
                              "get_my_workspace_secret",
                              {
                                  p_workspace_id: ownWorkspace.id
                              }
                          );

                    if (secretError) {
                        console.error(
                            "[DK Workspace] Failed to get secret:",
                            secretError
                        );

                        alert(
                            "Failed to get workspace secret: " +
                            secretError.message
                        );

                        return;
                    }

                    // =====================================================
                    // SECRET POPUP
                    // =====================================================

                    const overlay = document.createElement("div");

                    overlay.style.cssText = `
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.45);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 999999;
    `;

                    const box = document.createElement("div");

                    box.style.cssText = `
        width: 360px;
        padding: 18px;
        background: #fff;
        border-radius: 8px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.25);
        box-sizing: border-box;
        font-family: Arial, sans-serif;
    `;

                    const title = document.createElement("div");

                    title.textContent = "🔑 Workspace secret";

                    title.style.cssText = `
        font-size: 17px;
        font-weight: bold;
        margin-bottom: 14px;
        color: #222;
    `;

                    function createCopyRow(label, value) {

                        const row = document.createElement("div");

                        row.style.cssText = `
            margin-bottom: 12px;
        `;

                        const labelEl = document.createElement("div");

                        labelEl.textContent = label;

                        labelEl.style.cssText = `
            font-size: 13px;
            font-weight: bold;
            margin-bottom: 4px;
            color: #555;
        `;

                        const line = document.createElement("div");

                        line.style.cssText = `
            display: flex;
            gap: 5px;
        `;

                        const input = document.createElement("input");

                        input.type = "text";
                        input.value = value;
                        input.readOnly = true;

                        input.style.cssText = `
            flex: 1;
            height: 30px;
            padding: 3px 6px;
            box-sizing: border-box;
            border: 1px solid #aaa;
            border-radius: 4px;
            font-size: 13px;
            color: #222;
            background: #f8f8f8;
        `;

                        const copyButton = document.createElement("button");

                        copyButton.type = "button";
                        copyButton.textContent = "Copy";

                        copyButton.style.cssText = `
            width: 60px;
            height: 30px;
            cursor: pointer;
            border: 1px solid #aaa;
            border-radius: 4px;
            background: #f5f5f5;
            color: #222;
            font-size: 12px;
        `;

                        copyButton.addEventListener("click", async function () {

                            try {

                                await navigator.clipboard.writeText(value);

                                copyButton.textContent = "Copied";

                                setTimeout(() => {
                                    copyButton.textContent = "Copy";
                                }, 1000);

                            } catch (err) {

                                input.select();
                                document.execCommand("copy");

                                copyButton.textContent = "Copied";

                                setTimeout(() => {
                                    copyButton.textContent = "Copy";
                                }, 1000);
                            }
                        });

                        line.appendChild(input);
                        line.appendChild(copyButton);

                        row.appendChild(labelEl);
                        row.appendChild(line);

                        return row;
                    }

                    box.appendChild(title);

                    box.appendChild(
                        createCopyRow(
                            "Workspace name",
                            ownWorkspace.name
                        )
                    );

                    box.appendChild(
                        createCopyRow(
                            "Secret",
                            secret
                        )
                    );

                    const closeButton = document.createElement("button");

                    closeButton.type = "button";
                    closeButton.textContent = "Close";

                    closeButton.style.cssText = `
        width: 100%;
        height: 30px;
        margin-top: 4px;
        cursor: pointer;
        border: 1px solid #aaa;
        border-radius: 4px;
        background: #f5f5f5;
        color: #222;
        font-size: 13px;
    `;

                    closeButton.addEventListener("click", function () {
                        overlay.remove();
                    });

                    box.appendChild(closeButton);

                    overlay.appendChild(box);

                    overlay.addEventListener("click", function (e) {
                        if (e.target === overlay) {
                            overlay.remove();
                        }
                    });

                    document.body.appendChild(overlay);

                    return;
                }

                const confirmed = confirm(
                    "Create your own workspace?"
                );

                if (!confirmed) {
                    return;
                }

                // =========================================
                // CHƯA CÓ WORKSPACE → CREATE
                // =========================================

                const workspaceName =
                      `${currentUserOpenId} ${getMyUserInfo()?.nick || ""}`.trim();

                const generatedSecret =
                      crypto.randomUUID().replace(/-/g, "");

                const { data: newWorkspace, error: createError } =
                      await supabase.rpc(
                          "create_workspace",
                          {
                              p_name: workspaceName,
                              p_secret: generatedSecret
                          }
                      );

                if (createError) {
                    console.error(
                        "[DK Workspace] Failed to create workspace:",
                        createError
                    );

                    alert(
                        "Failed to create workspace: " +
                        createError.message
                    );

                    return;
                }

                clearLabelUI();

                Object.keys(activeUsers).forEach(key => {
                    delete activeUsers[key];
                });

                currentWorkspaceId =
                    newWorkspace.id;

                currentWorkspaceOwnerOpenId =
                    newWorkspace.owner_open_id;

                alert(
                    `Workspace created!\n\nWorkspace: ${newWorkspace.name}\n\nSecret:\n${generatedSecret}`
                );

                await loadWorkspaceOptions();

                const select =
                      document.querySelector(
                          "#dk-workspace-combobox"
                      );

                if (select) {
                    select.value =
                        String(currentWorkspaceId);
                }

                applyAll();

            } finally {
                createTitle.style.pointerEvents = "auto";
            }
        });

        // =========================================================
        // SAVE UI REFERENCES
        // =========================================================

        window.dkWorkspaceUI = {
            joinTitle,
            joinArea,
            joinNameInput,
            joinSecretInput,
            joinButton,
            createTitle
        };


        // =========================================================
        // APPEND
        // =========================================================

        actionArea.appendChild(joinTitle);
        actionArea.appendChild(joinArea);

        actionArea.appendChild(createTitle);


        panel.appendChild(actionArea);

        target.parentElement.insertBefore(
            panel,
            target
        );

        // =========================================================
        // SWITCH WORKSPACE
        // =========================================================

        select.addEventListener("change", function () {
            const newWorkspaceId = this.value;
            if (!newWorkspaceId) return;

            Object.keys(activeUsers).forEach(key => {
                delete activeUsers[key];
            });

            clearLabelUI();

            currentWorkspaceId = Number(newWorkspaceId);

            currentWorkspaceOwnerOpenId =
                this.options[
                this.selectedIndex
            ].dataset.ownerOpenId;

            console.log(
                "[DK Workspace] Switched to:",
                currentWorkspaceId
            );

            console.log(
                "[DK Workspace] Workspace owner:",
                currentWorkspaceOwnerOpenId
            );

            applyAll();
        });

        console.log(
            "[DK Workspace] Combobox + actions created"
        );
    }

    // =========================================================
    // START
    // =========================================================

    console.log(
        "[DK Label] READY v2.2.0"
    );

    createWorkspaceCombobox();

    async function loadWorkspaceOptions() {
        if (!supabase) {
            return;
        }

        const select =
              document.querySelector(
                  "#dk-workspace-combobox"
              );

        if (!select) {
            return;
        }

        const { data: workspaces, error } =
              await supabase.rpc(
                  "get_my_workspaces"
              );

        if (error) {
            console.error(
                "[DK Workspace] Failed to load workspaces:",
                error
            );
            return;
        }

        // Xóa option cũ
        select.innerHTML = "";


        // Thêm các workspace
        for (const workspace of workspaces || []) {
            const option =
                  document.createElement("option");

            option.value = workspace.id;
            option.textContent = workspace.name;
            option.dataset.ownerOpenId =
                workspace.owner_open_id;

            select.appendChild(option);
        }

        // =========================================================
        // CHECK USER ĐÃ CÓ OWN WORKSPACE CHƯA
        // =========================================================

        const hasOwnWorkspace =
              (workspaces || []).some(
                  workspace =>
                  workspace.owner_open_id ===
                  currentUserOpenId
              );

        if (window.dkWorkspaceUI) {

            window.dkWorkspaceUI.createTitle.textContent =
                hasOwnWorkspace
                ? "🔑 Get secret"
            : "➕ Create own workspace";

            window.dkWorkspaceUI.createTitle.style.display =
                "block";
        }

        // Chọn workspace hiện tại
        // =========================================================
        // DEFAULT WORKSPACE
        // Ưu tiên workspace mình làm OWNER
        // Nếu không có → lấy workspace đầu tiên mình là MEMBER
        // =========================================================

        const ownWorkspace =
              (workspaces || []).find(
                  workspace =>
                  workspace.owner_open_id ===
                  currentUserOpenId
              );

        const defaultWorkspace =
              ownWorkspace ||
              (workspaces || [])[0];

        if (defaultWorkspace) {

            currentWorkspaceId =
                defaultWorkspace.id;

            currentWorkspaceOwnerOpenId =
                defaultWorkspace.owner_open_id;

            select.value =
                String(defaultWorkspace.id);

            console.log(
                "[DK Workspace] Default workspace:",
                defaultWorkspace
            );

            applyAll();

        }

        console.log(
            "[DK Workspace] Options loaded:",
            workspaces
        );

        console.log(
            "[DK Workspace] Has own workspace:",
            hasOwnWorkspace
        );
    }

    console.log(
        "[DK Label] Identity key: userInfo.openId"
    );

    console.log(
        "[DK Label] Records:",
        records
    );

    applyAll();

    installObserver();

    // ---------------------------------------------------------
    // Periodic refresh
    // ---------------------------------------------------------
    //
    // Chỉ refresh UI.
    // Không thay đổi record nếu openId đã tồn tại.
    //
    // ---------------------------------------------------------

    setInterval(() => {
        applyAll();
    }, 5000);

})();
