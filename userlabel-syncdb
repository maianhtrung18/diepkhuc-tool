// ==UserScript==
// @name         Diep Khuc - Persistent User Labels
// @namespace    diep-khuk-user-labels
// @version      2.2.0
// @description  Persistent custom labels using userInfo.openId
// @match        https://diepkhuc.com/*
// @match        https://www.diepkhuc.com/*
// @run-at       document-idle
// @grant        none
// ==/UserScript==

(function () {
    "use strict";
    // =========================================================
    // SUPABASE CONNECTION
    // =========================================================

    const SUPABASE_URL = "https://bawpoebuldxlvbrwmvrw.supabase.co";
    const SUPABASE_KEY = "sb_publishable_lIhggWrSkFhe3BLeJmDpvw_oLfmd2bV";

    let supabase = null;
    let currentWorkspaceId = null;
    let currentWorkspaceOwnerOpenId = null;
    let currentUserOpenId = null;
    const pendingRecords = {};
    const activeUsers = {};
    const updateTimers = {};

    function loadSupabase() {
        return new Promise((resolve, reject) => {
            if (window.supabase) {
                supabase = window.supabase.createClient(
                    SUPABASE_URL,
                    SUPABASE_KEY
                );

                console.log("[DK] Supabase connected");
                resolve(supabase);
                return;
            }

            const script = document.createElement("script");

            script.src =
                "https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2";

            script.onload = () => {
                try {
                    supabase = window.supabase.createClient(
                        SUPABASE_URL,
                        SUPABASE_KEY
                    );

                    console.log("[DK] Supabase connected");
                    resolve(supabase);
                } catch (err) {
                    console.error(
                        "[DK] Supabase connection failed:",
                        err
                    );
                    reject(err);
                }
            };

            script.onerror = () => {
                console.error("[DK] Failed to load Supabase");
                reject(new Error("Failed to load Supabase"));
            };

            document.head.appendChild(script);
        });
    }

    loadSupabase().then(() => {
        const script = document.createElement("script");

        script.textContent = `
        (function waitForDKUser() {
            try {
                const u = getMyUserInfo();

                if (u && u.openId) {
                    document.documentElement.setAttribute(
                        "data-dk-current-user",
                        JSON.stringify(u)
                    );

                    document.documentElement.setAttribute(
                        "data-dk-current-user-ready",
                        "1"
                    );

                    return;
                }
            } catch (e) {}

            setTimeout(waitForDKUser, 500);
        })();
    `;

        document.documentElement.appendChild(script);
        script.remove();

        const waitForUser = setInterval(() => {
            const raw =
                  document.documentElement.getAttribute(
                      "data-dk-current-user"
                  );

            if (!raw) {
                return;
            }

            clearInterval(waitForUser);

            const userInfo = JSON.parse(raw);

            console.log("[DK] Current user:", userInfo);

            checkUserWorkspace(userInfo);
        }, 100);
    });
    // =========================================================
    // WORKSPACE CHECK
    // =========================================================

    async function checkUserWorkspace(userInfo) {
        if (!supabase || !userInfo) {
            return;
        }

        const openId = getOpenId(userInfo);
        currentUserOpenId = openId;

        if (!openId) {
            console.error("[DK] Cannot get current user openId");
            return;
        }

        // 1. Anonymous auth
        const { data: authData, error: authError } =
              await supabase.auth.signInAnonymously();

        if (authError) {
            console.error("[DK] Anonymous auth failed:", authError);
            return;
        }

        console.log(
            "[DK] Auth OK:",
            authData.user?.id
        );

        // 2. Register current user
        const { error: registerError } =
              await supabase.rpc(
                  "register_current_user",
                  {
                      p_open_id: openId,
                      p_nick: userInfo.nick || ""
                  }
              );

        if (registerError) {
            console.error(
                "[DK] Register current user failed:",
                registerError
            );
            return;
        }

        console.log(
            "[DK] Current user registered:",
            openId
        );

        // 3. Check workspaces
        const { data: workspaces, error: workspaceError } =
              await supabase.rpc("get_my_workspaces");

        if (workspaceError) {
            console.error(
                "[DK] Check workspace failed:",
                workspaceError
            );
            return;
        }

        console.log(
            "[DK] My workspaces:",
            workspaces
        );

        // 4. Already has workspace → do nothing
        if (workspaces && workspaces.length > 0) {
            currentWorkspaceId = workspaces[0].id;
            currentWorkspaceOwnerOpenId =
                workspaces[0].owner_open_id;

            console.log(
                "[DK] Using workspace:",
                currentWorkspaceId
            );

            console.log(
                "[DK] Workspace owner:",
                currentWorkspaceOwnerOpenId
            );
            applyAll();
            return;
        }

        // 5. No workspace → create one
        const workspaceName =
              `${openId} ${userInfo.nick || ""}`.trim();

        const workspaceSecret =
              crypto.randomUUID();

        const { data: newWorkspace, error: createError } =
              await supabase.rpc(
                  "create_workspace",
                  {
                      p_name: workspaceName,
                      p_secret: workspaceSecret
                  }
              );

        if (createError) {
            console.error(
                "[DK] Create workspace failed:",
                createError
            );
            return;
        }

        console.log(
            "[DK] Workspace created:",
            newWorkspace
        );

        currentWorkspaceId = newWorkspace.id;

        console.log(
            "[DK] Using workspace:",
            currentWorkspaceId
        );
    }

    const STORAGE_KEY = "__dk_user_labels_openid_v2__";

    let records = loadRecords();

    // =========================================================
    // STORAGE
    // =========================================================

    function loadRecords() {
        try {
            const raw = localStorage.getItem(STORAGE_KEY);

            if (!raw) {
                return {};
            }

            const data = JSON.parse(raw);

            if (!data || typeof data !== "object") {
                return {};
            }

            return data;
        } catch (err) {
            console.error(
                "[DK Label] Failed to load records:",
                err
            );

            return {};
        }
    }

    function saveRecords() {
        try {
            localStorage.setItem(
                STORAGE_KEY,
                JSON.stringify(records)
            );
        } catch (err) {
            console.error(
                "[DK Label] Failed to save records:",
                err
            );
        }
    }

    // =========================================================
    // SYNC GIỮA CÁC TAB
    // =========================================================

    window.addEventListener("storage", function (e) {
        if (e.key !== STORAGE_KEY) {
            return;
        }

        records = loadRecords();

        console.log(
            "[DK Label] Synced from another tab"
        );

        applyAll();
    });

    // =========================================================
    // REACT FIBER
    // =========================================================

    function getFiberKey(el) {
        if (!el) {
            return null;
        }

        return Object.keys(el).find(
            key => key.startsWith("__reactFiber$")
        ) || null;
    }

    function getUserInfoFromElement(el) {
        if (!el) {
            return null;
        }

        const fiberKey = getFiberKey(el);

        if (!fiberKey) {
            return null;
        }

        let fiber = el[fiberKey];

        for (let i = 0; i < 50 && fiber; i++) {
            const props = fiber.memoizedProps;

            if (props?.userInfo?.userId) {
                return props.userInfo;
            }

            fiber = fiber.return;
        }

        return null;
    }

    // =========================================================
    // IDENTITY
    // =========================================================

    function getOpenId(userInfo) {
        if (!userInfo) {
            return null;
        }

        const value = userInfo.openId;

        if (
            value === undefined ||
            value === null ||
            value === ""
        ) {
            return null;
        }

        return String(value);
    }

    // =========================================================
    // RECORD
    // =========================================================
    //
    // openId CHƯA CÓ:
    //     tạo record
    //     label = nickname hiện tại
    //
    // openId ĐÃ CÓ:
    //     giữ nguyên record
    //     KHÔNG overwrite label
    //     KHÔNG overwrite nick
    //
    // =========================================================

    async function ensureRecord(userInfo) {
        const openId = getOpenId(userInfo);

        if (!openId || !currentWorkspaceId || !supabase) {
            return null;
        }

        const requestKey =
              `${currentWorkspaceId}:${openId}`;

        // Đang check user này → dùng chung Promise
        if (pendingRecords[requestKey]) {
            return await pendingRecords[requestKey];
        }

        pendingRecords[requestKey] = (async () => {

            // 1. Check Supabase
            const { data, error } = await supabase
            .from("user_labels")
            .select("label")
            .eq("workspace_id", currentWorkspaceId)
            .eq("target_open_id", openId)
            .maybeSingle();

            if (error) {
                console.error(
                    `[DK Label] Failed to check ${openId}:`,
                    error
                );

                return null;
            }

            // 2. Supabase đã có label
            if (data) {
                const oldRecord = records[openId];

                const record = {
                    nick: userInfo.nick || "",
                    label: data.label || "",
                    updated: true
                };

                if (!oldRecord || oldRecord.label !== record.label) {
                    records[openId] = record;
                    saveRecords();

                    console.log(
                        `[DK Label] DB changed: ${openId} → ${record.label}`
                    );
                }

                return record;
            }

            // 3. Supabase chưa có
            // Có local → dùng local
            // Không có local → dùng nickname
            const oldRecord = records[openId];
            const currentNick = userInfo.nick || "";

            const record = oldRecord || {
                nick: currentNick,
                label: currentNick,
                updated: false
            };

            records[openId] = record;
            saveRecords();

            // 4. Tạo record trên Supabase
            const { error: insertError } = await supabase
            .from("user_labels")
            .insert({
                workspace_id: currentWorkspaceId,
                target_open_id: openId,
                label: record.label,
                created_by: currentUserOpenId,
                updated_by: currentUserOpenId
            });

            if (insertError) {
                console.error(
                    `[DK Label] Failed to create ${openId}:`,
                    insertError
                );

                return record;
            }

            console.log(
                `[DK Label] New user synced: ${openId} → ${record.label}`
            );

            return record;

        })();

        try {
            return await pendingRecords[requestKey];
        } finally {
            delete pendingRecords[requestKey];
        }
    }

    // =========================================================
    // CREATE UI
    // =========================================================

    function createUI(item, userInfo, record) {
        if (!item || !userInfo || !record) {
            return;
        }

        const nickEl = item.querySelector(".nick");

        if (!nickEl) {
            return;
        }

        // UI đã tồn tại
        if (
            nickEl.parentElement?.querySelector(
                ".dk-user-label-wrap"
            )
        ) {
            return;
        }

        const openId = getOpenId(userInfo);
        console.log(
            "[DK Label] Processing:",
            openId,
            userInfo.nick
        );

        if (!openId) {
            return;
        }

        // -----------------------------------------------------
        // Wrapper
        // -----------------------------------------------------

        const wrap = document.createElement("span");

        wrap.className = "dk-user-label-wrap";

        wrap.style.cssText = `
            display: inline-flex;
            align-items: center;
            margin-left: 6px;
            vertical-align: middle;
        `;

        // -----------------------------------------------------
        // Input
        // -----------------------------------------------------

        const input = document.createElement("input");

        input.className = "dk-user-label-input";
        input.type = "text";

        input.value = record.label || "";
        if (
            currentWorkspaceOwnerOpenId &&
            currentWorkspaceOwnerOpenId !== currentUserOpenId
        ) {
            input.disabled = true;
        }

        input.style.cssText = `
            width: 130px;
            height: 24px;
            padding: 0px 3px;
            box-sizing: border-box;
            border: 1px solid #aaa;
            border-radius: 3px;
            font-size: 18px;
            line-height: 20px;
            color: #222;
            background: #fff;
            outline: none;
        `;

        // -----------------------------------------------------
        // Khi gõ → lưu NGAY
        // -----------------------------------------------------

        input.addEventListener("input", function () {
            const currentRecord = records[openId];

            if (!currentRecord) {
                return;
            }

            // Local cập nhật ngay từng ký tự
            currentRecord.label = input.value;
            currentRecord.updated = true;

            saveRecords();
            applyAll();

            console.log(
                `[DK Label] Saved local: ${openId} → ${currentRecord.label}`
            );

            // -----------------------------------------------------
            // Supabase: debounce 500ms
            // -----------------------------------------------------

            clearTimeout(currentRecord.updateTimer);

            currentRecord.updateTimer = setTimeout(async function () {
                if (!supabase || !currentWorkspaceId || !currentUserOpenId) {
                    return;
                }

                const labelToSave = currentRecord.label;

                const { error } = await supabase
                .from("user_labels")
                .update({
                    label: labelToSave,
                    updated_by: currentUserOpenId,
                    updated_at: new Date().toISOString()
                })
                .eq("workspace_id", currentWorkspaceId)
                .eq("target_open_id", openId);

                if (error) {
                    console.error(
                        `[DK Label] Failed to update ${openId}:`,
                        error
                    );
                } else {
                    console.log(
                        `[DK Label] Updated Supabase: ${openId} → ${labelToSave}`
                    );
                }
            }, 500);
        });

        // -----------------------------------------------------
        // Không cho click input trigger item
        // -----------------------------------------------------

        input.addEventListener("click", function (e) {
            e.stopPropagation();
        });

        input.addEventListener("mousedown", function (e) {
            e.stopPropagation();
        });

        input.addEventListener("mouseup", function (e) {
            e.stopPropagation();
        });

        input.addEventListener("keydown", function (e) {
            e.stopPropagation();
        });

        // -----------------------------------------------------
        // Append
        // -----------------------------------------------------

        wrap.appendChild(input);

        nickEl.append(wrap);
    }

    // =========================================================
    // UPDATE EXISTING UI
    // =========================================================
    //
    // Cực kỳ quan trọng:
    //
    // Nếu input đang focus → KHÔNG BAO GIỜ overwrite value.
    //
    // Nhờ vậy:
    //
    // gõ A
    // gõ AB
    // gõ ABC
    //
    // React re-render giữa chừng cũng không làm mất chữ.
    //
    // =========================================================

    function updateExistingUI(item, record) {
        if (!item || !record) {
            return;
        }

        const wrap =
              item.querySelector(
                  ".dk-user-label-wrap"
              );

        if (!wrap) {
            return;
        }

        const input =
              wrap.querySelector(
                  ".dk-user-label-input"
              );

        if (!input) {
            return;
        }

        input.disabled =
            currentWorkspaceOwnerOpenId &&
            currentWorkspaceOwnerOpenId !== currentUserOpenId;

        // Đang gõ
        if (document.activeElement === input) {
            return;
        }

        // Không focus → sync từ storage
        const savedLabel = record.label || "";

        if (input.value !== savedLabel) {
            input.value = savedLabel;
        }
    }

    // =========================================================
    // PROCESS ITEM
    // =========================================================

    async function processItem(item) {
        if (!item) {
            return;
        }

        if (!item.classList.contains("item")) {
            return;
        }

        const userInfo =
              getUserInfoFromElement(item);

        if (!userInfo) {
            return;
        }

        const openId =
              getOpenId(userInfo);

        if (!openId) {
            return;
        }

        const userKey =
              `${currentWorkspaceId}:${openId}`;

        // =====================================================
        // 1. LOCAL FIRST
        // =====================================================

        let record = records[openId];

        // Chưa có local → dùng nickname làm label tạm
        if (!record) {
            const currentNick = userInfo.nick || "";

            record = {
                nick: currentNick,
                label: currentNick,
                updated: false
            };

            records[openId] = record;
            saveRecords();
        }

        // Gắn label từ LOCAL ngay lập tức
        createUI(
            item,
            userInfo,
            record
        );

        updateExistingUI(
            item,
            record
        );

        // =====================================================
        // 2. USER ĐANG ACTIVE → KHÔNG SYNC LẠI
        // =====================================================

        if (activeUsers[userKey]) {
            return;
        }

        activeUsers[userKey] = true;

        // =====================================================
        // 3. SUPABASE SYNC BACKGROUND
        // =====================================================

        ensureRecord(userInfo)
            .then((syncedRecord) => {
            if (!syncedRecord) {
                return;
            }

            // DB có kết quả mới → cập nhật UI
            updateExistingUI(
                item,
                syncedRecord
            );
        })
            .catch((err) => {
            console.error(
                `[DK Label] Background sync failed: ${openId}`,
                err
            );
        });
    }

    // =========================================================
    // APPLY ALL
    // =========================================================

    async function applyAll() {
        const items =
              document.querySelectorAll(
                  ".user-list .item"
              );

        let applied = 0;

        const currentUsers = {};

        for (const item of items) {
            const userInfo =
                  getUserInfoFromElement(item);

            if (!userInfo) {
                continue;
            }

            const openId =
                  getOpenId(userInfo);

            if (!openId) {
                continue;
            }

            const userKey =
                  `${currentWorkspaceId}:${openId}`;

            currentUsers[userKey] = true;

            const existed =
                  !!item.querySelector(
                      ".dk-user-label-wrap"
                  );

            await processItem(item);

            const existsNow =
                  !!item.querySelector(
                      ".dk-user-label-wrap"
                  );

            if (!existed && existsNow) {
                applied++;
            }
        }

        // User không còn trong room → reset trạng thái
        for (const key of Object.keys(activeUsers)) {
            if (!currentUsers[key]) {
                delete activeUsers[key];
            }
        }

        if (applied > 0) {
            console.log(
                `[DK Label] Applied: ${applied} items`
            );
        }
    }

    // =========================================================
    // OBSERVER
    // =========================================================

    function installObserver() {
        const userList =
              document.querySelector(
                  ".user-list"
              );

        if (!userList) {
            setTimeout(
                installObserver,
                1000
            );

            return;
        }

        const observer =
              new MutationObserver(() => {
                  applyAll();
              });

        observer.observe(
            userList,
            {
                childList: true,
                subtree: true
            }
        );

        console.log(
            "[DK Label] Observer installed"
        );
    }

    // =========================================================
    // WORKSPACE COMBOBOX UI
    // =========================================================

    function createWorkspaceCombobox() {
        if (document.querySelector("#dk-workspace-combobox")) {
            return;
        }

        const target =
              document.querySelector(
                  'div[data-class="DynamicButton"]'
              )?.parentElement;

        if (!target) {
            setTimeout(createWorkspaceCombobox, 1000);
            return;
        }

        const select = document.createElement("select");

        select.id = "dk-workspace-combobox";

        select.style.cssText = `
        width: 180px;
        height: 32px;
        margin-bottom: 5px;
        padding: 2px 6px;
        box-sizing: border-box;
        border: 1px solid #aaa;
        border-radius: 4px;
        background: #fff;
        color: #222;
        font-size: 14px;
        outline: none;
    `;

        const option = document.createElement("option");

        option.value = "";
        option.textContent = "Workspace";

        select.appendChild(option);

        target.parentElement.insertBefore(
            select,
            target
        );

        select.addEventListener("change", function () {
            const newWorkspaceId = this.value;

            if (!newWorkspaceId) {
                return;
            }

            currentWorkspaceId = Number(newWorkspaceId);

            currentWorkspaceOwnerOpenId =
                this.options[this.selectedIndex].dataset.ownerOpenId;

            console.log(
                "[DK Workspace] Switched to:",
                currentWorkspaceId
            );

            console.log(
                "[DK Workspace] Workspace owner:",
                currentWorkspaceOwnerOpenId
            );

            applyAll();
        });

        console.log(
            "[DK Workspace] Combobox created"
        );
    }

    // =========================================================
    // START
    // =========================================================

    console.log(
        "[DK Label] READY v2.2.0"
    );

    createWorkspaceCombobox();

    setTimeout(() => {
        loadWorkspaceOptions();
    }, 1000);
    async function loadWorkspaceOptions() {
        if (!supabase) {
            return;
        }

        const select =
              document.querySelector(
                  "#dk-workspace-combobox"
              );

        if (!select) {
            return;
        }

        const { data: workspaces, error } =
              await supabase.rpc(
                  "get_my_workspaces"
              );

        if (error) {
            console.error(
                "[DK Workspace] Failed to load workspaces:",
                error
            );
            return;
        }

        // Xóa option cũ
        select.innerHTML = "";

        for (const workspace of workspaces || []) {
            const option =
                  document.createElement("option");

            option.value = workspace.id;
            option.textContent = workspace.name;
            option.dataset.ownerOpenId = workspace.owner_open_id;

            select.appendChild(option);
        }

        // Chọn workspace hiện tại
        if (currentWorkspaceId) {
            select.value =
                String(currentWorkspaceId);
        }

        console.log(
            "[DK Workspace] Options loaded:",
            workspaces
        );
    }

    console.log(
        "[DK Label] Identity key: userInfo.openId"
    );

    console.log(
        "[DK Label] Records:",
        records
    );

    applyAll();

    installObserver();

    // ---------------------------------------------------------
    // Periodic refresh
    // ---------------------------------------------------------
    //
    // Chỉ refresh UI.
    // Không thay đổi record nếu openId đã tồn tại.
    //
    // ---------------------------------------------------------

    setInterval(() => {
        applyAll();
    }, 5000);

})();
